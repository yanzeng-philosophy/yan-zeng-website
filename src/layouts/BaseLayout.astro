---
import "../styles/global.css";
import {
  hrefForPage,
  languages,
  layoutText,
  navLabels,
  navOrder,
  type Lang,
  type PageKey
} from "../data/i18n";

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  pageKey?: PageKey;
  languageHrefs?: Partial<Record<Lang, string>>;
}

const {
  title = "Yan Zeng",
  description = "Personal academic website for research, writing, and public notes.",
  lang = "en",
  pageKey = "home",
  languageHrefs = {}
} = Astro.props;

const siteTitle = title === "Yan Zeng" ? title : `${title} | Yan Zeng`;
const text = layoutText[lang];
const navItems = navOrder.map((key) => ({
  href: hrefForPage(key, lang),
  label: navLabels[lang][key]
}));
const languageLinks = (Object.keys(languages) as Lang[]).map((code) => ({
  code,
  ...languages[code],
  href: languageHrefs[code] ?? hrefForPage(pageKey, code)
}));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <title>{siteTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{text.skip}</a>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="site-mark" href={hrefForPage("home", lang)} aria-label="Yan Zeng home">
          <span class="site-mark__name">Yan Zeng</span>
          <span class="site-mark__meta">{text.meta}</span>
        </a>
        <div class="site-header__controls">
          <nav class="site-nav" aria-label={text.navLabel}>
            {
              navItems.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))
            }
          </nav>
          <nav class="language-switcher" aria-label={text.languageLabel}>
            {
              languageLinks.map((item) => (
                <a
                  href={item.href}
                  aria-current={item.code === lang ? "page" : undefined}
                  title={item.label}
                >
                  {item.short}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{text.footer}</p>
    </footer>
  </body>
</html>
