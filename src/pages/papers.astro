---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Papers" description="Public paper information for Yan Zeng." pageKey="papers">
  <div class="page">
    <header class="page-title">
      <p class="eyebrow">Papers</p>
      <h1>Papers</h1>
      <p>Published, accepted, and otherwise public work will be listed here.</p>
    </header>

    <section class="section-grid" aria-label="Paper policy">
      <article class="panel">
        <h3>Publication Policy</h3>
        <p>
          I list papers here when they are published, accepted, or otherwise
          approved for public circulation.
        </p>
      </article>

      <article class="panel">
        <h3>Current Manuscripts</h3>
        <p>
          Manuscripts that are unpublished, under review, or still being
          developed are not listed with titles, abstracts, or argument details.
        </p>
      </article>

      <article class="panel">
        <h3>Research Overview</h3>
        <p>
          For a public overview of my research areas, see the Research page.
        </p>
        <p><a href="https://yanzeng-philosophy.github.io/yan-zeng-website/research/">Go to Research</a></p>
      </article>

      <article class="panel">
        <h3>Public Work</h3>
        <p class="muted">No published or accepted papers are listed yet.</p>
        <p>This page will be updated when there is work ready to circulate publicly.</p>
      </article>
    </section>
  </div>
</BaseLayout>
