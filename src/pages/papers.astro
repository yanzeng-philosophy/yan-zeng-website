    </header>

    <section class="section-grid" aria-label="Paper list">
      <article class="panel">
        <h3>Paper Title Placeholder</h3>
        <p class="muted">Status: in preparation. Add public details only when ready.</p>
      </article>
    </section>
  </div>
</BaseLayout>
