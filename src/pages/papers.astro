---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Papers" description="Public paper information for Yan Zeng." pageKey="papers">
  <div class="page">
    <header class="page-title">
      <p class="eyebrow">Papers</p>
      <h1>Papers</h1>
      <p>Works in progress and public paper information. Preprints will be added only when approved for circulation.</p>
    </header>

    <section class="section-grid" aria-label="Paper list">
      <article class="panel">
        <h3>Unfair Role-Burden Allocation and the Structure of AI Trust</h3>
        <p class="muted">Manuscript in progress.</p>
        <p>
          Develops a structural account of AI trust centered on fair role
          allocation in human-AI dependence relations.
        </p>
      </article>

      <article class="panel">
        <h3>Collective Forgiveness as a Thin Practical-Normative Act</h3>
        <p class="muted">Manuscript in progress.</p>
        <p>
          Defends a thin practical account of collective forgiveness against
          group-mind objections.
        </p>
      </article>

      <article class="panel">
        <h3>Simplicity and Complexity in Philosophy and Science</h3>
        <p class="muted">Course paper / work in progress.</p>
        <p>
          Examines simplicity and complexity as complementary methodological
          principles in inquiry.
        </p>
      </article>

      <article class="panel">
        <h3>Hume on Miracles, Testimony, and Evidential Proportionality</h3>
        <p class="muted">Course paper.</p>
        <p>
          Reconstructs Hume's argument in "Of Miracles" through testimony and
          comparative probability.
        </p>
      </article>
    </section>
  </div>
</BaseLayout>
