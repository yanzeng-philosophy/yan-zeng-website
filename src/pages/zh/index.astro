---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../../components/ContentList.astro";
import { hrefForPage } from "../../data/i18n";

const entries = (await getCollection("public")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const translatedEntryIds = new Set(
  entries
    .filter((entry) => entry.id.startsWith("zh/"))
    .map((entry) => entry.id.replace(/^zh\//, ""))
);
const latestEntries = entries
  .filter(
    (entry) =>
      entry.id.startsWith("zh/") ||
      (!entry.id.startsWith("ja/") && !translatedEntryIds.has(entry.id))
  )
  .slice(0, 3);
---

<BaseLayout
  title="Yan Zeng"
  description="Yan Zeng 的个人学术主页：哲学、AI 伦理、信任与公开研究札记。"
  lang="zh"
  pageKey="home"
>
  <div class="page">
    <section class="hero" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">加州大学尔湾分校哲学系博士生</p>
        <h1 id="home-title">Yan Zeng</h1>
        <p class="hero__dek">
          我研究 AI 系统如何重塑信任、责任和人的能动性。这个网站既是我的学术主页，
          也是一个公开笔记本，用来积累经过审核的研究、写作、项目和可公开的反思。
        </p>
        <div class="hero__actions">
          <a class="button" href={hrefForPage("research", "zh")}>阅读研究</a>
          <a class="button button--secondary" href={hrefForPage("now", "zh")}>查看近况</a>
        </div>
      </div>

      <aside class="hero-preview" aria-label="精选写作">
        <div class="hero-preview__chrome" aria-hidden="true">
          <span class="hero-preview__dot"></span>
          <span class="hero-preview__dot"></span>
          <span class="hero-preview__dot"></span>
        </div>
        <a class="hero-preview__article" href="https://yanzeng-philosophy.github.io/yan-zeng-website/zh/notes/essays/soft-enclosure-convenience-dependence/">
          <p class="eyebrow">最新文章</p>
          <h2>柔软的围合</h2>
          <p>
            当便利变成依赖，形式自由仍然可以完整存在，而让自由可被使用的能力却在悄悄衰退。
          </p>
          <div class="hero-preview__meta">
            <span>文章</span>
            <span>AI</span>
            <span>语言</span>
          </div>
        </a>
        <div class="hero-preview__tiles" aria-label="网站主题">
          <div class="hero-preview__tile"><strong>研究</strong><span>信任、责任与 AI 中介实践。</span></div>
          <div class="hero-preview__tile"><strong>札记</strong><span>经过审核的文章、日志、项目与反思。</span></div>
          <div class="hero-preview__tile"><strong>近况</strong><span>当前工作与公开优先事项。</span></div>
        </div>
      </aside>
    </section>

    <section class="section" aria-labelledby="areas-title">
      <h2 id="areas-title">网站板块</h2>
      <div class="section-grid">
        <article class="panel">
          <h3>研究</h3>
          <p>关于信任、依赖、责任、AI 伦理和社会认识论的学术工作。</p>
        </article>
        <article class="panel">
          <h3>公开笔记本</h3>
          <p>经过审核的札记、文章、项目和反思，用来积累长期可用的知识资产。</p>
        </article>
        <article class="panel">
          <h3>近况</h3>
          <p>关于当前研究、写作和公开项目的简短更新。</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-title">
      <h2 id="latest-title">最新公开札记</h2>
      <ContentList entries={latestEntries} locale="zh" />
    </section>
  </div>
</BaseLayout>
