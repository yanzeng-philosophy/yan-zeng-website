---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../../components/ContentList.astro";

const entries = await getCollection("public");
const translatedEssayIds = new Set(
  entries
    .filter((entry) => entry.id.startsWith("zh/essays/"))
    .map((entry) => entry.id.replace(/^zh\//, ""))
);
const blogEntries = entries
  .filter(
    (entry) =>
      entry.id.startsWith("zh/essays/") ||
      (entry.id.startsWith("essays/") && !translatedEssayIds.has(entry.id))
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="札记" description="Yan Zeng 的公开文章与札记。" lang="zh" pageKey="blog">
  <div class="page">
    <header class="page-title">
      <p class="eyebrow">札记</p>
      <h1>Blog / Notes</h1>
      <p>经过审核的公开文章、学术札记和思想笔记。部分正文暂时保留英文原文。</p>
    </header>
    <ContentList entries={blogEntries} locale="zh" />
  </div>
</BaseLayout>
