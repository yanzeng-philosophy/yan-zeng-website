---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Secret"
  description="Encrypted private notes for trusted readers."
>
  <div class="page">
    <section class="secret-shell" aria-labelledby="secret-title">
      <div class="secret-shell__intro">
        <p class="eyebrow">Encrypted</p>
        <h1 id="secret-title">Secret Notes</h1>
        <p>
          Private notes for trusted readers. Choose a note, enter the password,
          and decrypt it locally in your browser.
        </p>
      </div>

      <div class="secret-panel">
        <form class="secret-form" id="secret-form">
          <label>
            Note
            <select id="secret-note" name="note"></select>
          </label>
          <label>
            Password
            <input id="secret-password" name="password" type="password" autocomplete="current-password" />
          </label>
          <button class="button" type="submit">Unlock</button>
        </form>
        <p class="secret-status" id="secret-status" role="status">Loading encrypted notes...</p>
        <article class="secret-output" id="secret-output" aria-live="polite"></article>
      </div>
    </section>
  </div>

  <script is:inline>
    const form = document.querySelector("#secret-form");
    const select = document.querySelector("#secret-note");
    const password = document.querySelector("#secret-password");
    const status = document.querySelector("#secret-status");
    const output = document.querySelector("#secret-output");

    const textDecoder = new TextDecoder();
    let notes = [];

    function fromBase64(value) {
      const binary = atob(value);
      const bytes = new Uint8Array(binary.length);
      for (let index = 0; index < binary.length; index += 1) {
        bytes[index] = binary.charCodeAt(index);
      }
      return bytes;
    }

    function escapeHtml(value) {
      return value
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;");
    }

    function inlineMarkdown(value) {
      return escapeHtml(value)
        .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
        .replace(/\*([^*]+)\*/g, "<em>$1</em>");
    }

    function renderMarkdown(markdown) {
      const blocks = markdown.trim().split(/\n{2,}/);
      return blocks.map((block) => {
        const trimmed = block.trim();
        if (trimmed.startsWith("### ")) {
          return `<h3>${inlineMarkdown(trimmed.slice(4))}</h3>`;
        }
        if (trimmed.startsWith("## ")) {
          return `<h2>${inlineMarkdown(trimmed.slice(3))}</h2>`;
        }
        if (trimmed.startsWith("# ")) {
          return `<h1>${inlineMarkdown(trimmed.slice(2))}</h1>`;
        }
        if (/^- /m.test(trimmed)) {
          const items = trimmed
            .split(/\n/)
            .filter((line) => line.startsWith("- "))
            .map((line) => `<li>${inlineMarkdown(line.slice(2))}</li>`)
            .join("");
          return `<ul>${items}</ul>`;
        }
        return `<p>${inlineMarkdown(trimmed).replace(/\n/g, "<br />")}</p>`;
      }).join("");
    }

    async function decryptNote(note, passphrase) {
      const response = await fetch(note.file);
      if (!response.ok) throw new Error("Encrypted note could not be loaded.");
      const payload = await response.json();
      const salt = fromBase64(payload.kdf.salt);
      const iv = fromBase64(payload.cipher.iv);
      const encrypted = fromBase64(payload.cipher.data);
      const keyMaterial = await crypto.subtle.importKey(
        "raw",
        new TextEncoder().encode(passphrase),
        "PBKDF2",
        false,
        ["deriveKey"]
      );
      const key = await crypto.subtle.deriveKey(
        {
          name: "PBKDF2",
          salt,
          iterations: payload.kdf.iterations,
          hash: payload.kdf.hash
        },
        keyMaterial,
        { name: "AES-GCM", length: 256 },
        false,
        ["decrypt"]
      );
      const plaintext = await crypto.subtle.decrypt(
        { name: "AES-GCM", iv },
        key,
        encrypted
      );
      return textDecoder.decode(plaintext);
    }

    async function loadManifest() {
      try {
        const response = await fetch("manifest.json");
        if (!response.ok) throw new Error("No manifest.");
        const manifest = await response.json();
        notes = manifest.notes || [];
        select.innerHTML = "";

        if (notes.length === 0) {
          status.textContent = "No encrypted notes have been published yet.";
          form.hidden = true;
          return;
        }

        for (const note of notes) {
          const option = document.createElement("option");
          option.value = note.slug;
          option.textContent = note.title;
          select.append(option);
        }

        status.textContent = "Choose a note and enter the password.";
      } catch {
        status.textContent = "Encrypted notes are not available yet.";
        form.hidden = true;
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      output.innerHTML = "";
      const note = notes.find((item) => item.slug === select.value);
      if (!note) return;

      status.textContent = "Decrypting...";
      try {
        const markdown = await decryptNote(note, password.value);
        output.innerHTML = renderMarkdown(markdown);
        status.textContent = "Unlocked.";
      } catch {
        status.textContent = "Could not unlock this note. Check the password.";
      }
    });

    loadManifest();
  </script>
</BaseLayout>
