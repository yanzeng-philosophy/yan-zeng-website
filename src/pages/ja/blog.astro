---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../../components/ContentList.astro";

const entries = await getCollection("public");
const translatedEssayIds = new Set(
  entries
    .filter((entry) => entry.id.startsWith("ja/essays/"))
    .map((entry) => entry.id.replace(/^ja\//, ""))
);
const blogEntries = entries
  .filter(
    (entry) =>
      entry.id.startsWith("ja/essays/") ||
      (entry.id.startsWith("essays/") && !translatedEssayIds.has(entry.id))
  )
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="ノート" description="Yan Zeng の公開エッセイとノート。" lang="ja" pageKey="blog">
  <div class="page">
    <header class="page-title">
      <p class="eyebrow">ノート</p>
      <h1>Blog / Notes</h1>
      <p>確認済みの公開エッセイ、学術ノート、思考の記録。本文の一部は現在英語で掲載しています。</p>
    </header>
    <ContentList entries={blogEntries} locale="ja" />
  </div>
</BaseLayout>
