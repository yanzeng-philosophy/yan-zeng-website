---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../../components/ContentList.astro";
import { hrefForPage } from "../../data/i18n";

const entries = (await getCollection("public")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const translatedEntryIds = new Set(
  entries
    .filter((entry) => entry.id.startsWith("ja/"))
    .map((entry) => entry.id.replace(/^ja\//, ""))
);
const latestEntries = entries
  .filter(
    (entry) =>
      entry.id.startsWith("ja/") ||
      (!entry.id.startsWith("zh/") && !translatedEntryIds.has(entry.id))
  )
  .slice(0, 3);
---

<BaseLayout
  title="Yan Zeng"
  description="Yan Zeng の個人学術サイト：哲学、AI倫理、信頼、公開研究ノート。"
  lang="ja"
  pageKey="home"
>
  <div class="page">
    <section class="hero" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">カリフォルニア大学アーバイン校 哲学科 PhD Student</p>
        <h1 id="home-title">Yan Zeng</h1>
        <p class="hero__dek">
          私はAIシステムが信頼、責任、人間の行為性をどのように作り変えるのかを研究しています。
          このサイトは、学術プロフィールであると同時に、研究、執筆、プロジェクト、選ばれた省察のための公開ノートです。
        </p>
        <div class="hero__actions">
          <a class="button" href={hrefForPage("research", "ja")}>研究を読む</a>
          <a class="button button--secondary" href={hrefForPage("now", "ja")}>近況を見る</a>
        </div>
      </div>

      <aside class="hero-preview" aria-label="注目の文章">
        <div class="hero-preview__chrome" aria-hidden="true">
          <span class="hero-preview__dot"></span>
          <span class="hero-preview__dot"></span>
          <span class="hero-preview__dot"></span>
        </div>
        <a class="hero-preview__article" href="https://yanzeng-philosophy.github.io/yan-zeng-website/ja/notes/essays/soft-enclosure-convenience-dependence/">
          <p class="eyebrow">最新エッセイ</p>
          <h2>柔らかな囲い込み</h2>
          <p>
            便利さが依存になるとき、形式的な自由は残っていても、それを使う能力は静かに衰えていく。
          </p>
          <div class="hero-preview__meta">
            <span>エッセイ</span>
            <span>AI</span>
            <span>言語</span>
          </div>
        </a>
        <div class="hero-preview__tiles" aria-label="サイトテーマ">
          <div class="hero-preview__tile"><strong>研究</strong><span>信頼、責任、AI媒介的実践。</span></div>
          <div class="hero-preview__tile"><strong>ノート</strong><span>確認済みの文章、ログ、プロジェクト、省察。</span></div>
          <div class="hero-preview__tile"><strong>近況</strong><span>現在の仕事と公開上の優先事項。</span></div>
        </div>
      </aside>
    </section>

    <section class="section" aria-labelledby="areas-title">
      <h2 id="areas-title">サイトの構成</h2>
      <div class="section-grid">
        <article class="panel">
          <h3>研究</h3>
          <p>信頼、依存、責任、AI倫理、社会認識論に関する学術研究。</p>
        </article>
        <article class="panel">
          <h3>公開ノート</h3>
          <p>確認済みのノート、エッセイ、プロジェクト、省察を長期的な知的資産として蓄積します。</p>
        </article>
        <article class="panel">
          <h3>近況</h3>
          <p>現在の研究、執筆、公開プロジェクトについての短い更新。</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-title">
      <h2 id="latest-title">最新の公開ノート</h2>
      <ContentList entries={latestEntries} locale="ja" />
    </section>
  </div>
</BaseLayout>
