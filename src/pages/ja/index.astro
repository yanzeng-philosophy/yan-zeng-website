---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContentList from "../../components/ContentList.astro";
import { hrefForPage } from "../../data/i18n";

const entries = (await getCollection("public")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const latestEntries = entries.filter((entry) => entry.id.startsWith("ja/")).slice(0, 3);
---

<BaseLayout
  title="Yan Zeng"
  description="Yan Zeng の個人学術サイト：哲学、AI倫理、信頼、公開研究ノート。"
  lang="ja"
  pageKey="home"
>
  <div class="page">
    <section class="hero" aria-labelledby="home-title">
      <div>
        <p class="eyebrow">カリフォルニア大学アーバイン校 哲学科 PhD Student</p>
        <h1 id="home-title">Yan Zeng</h1>
        <p class="hero__dek">
          私はAIシステムが信頼、責任、人間の行為性をどのように作り変えるのかを研究しています。
          このサイトは、学術プロフィールであると同時に、研究、執筆、プロジェクト、選ばれた省察のための公開ノートです。
        </p>
        <div class="hero__actions">
          <a class="button" href={hrefForPage("research", "ja")}>研究を読む</a>
          <a class="button button--secondary" href={hrefForPage("now", "ja")}>近況を見る</a>
        </div>
      </div>

      <aside class="research-visual" aria-label="研究テーマ">
        <div class="research-visual__grid">
          <div class="research-visual__cell"><strong>信頼</strong><span>AI媒介的実践</span></div>
          <div class="research-visual__cell"><strong>責任</strong><span>役割負担の配分</span></div>
          <div class="research-visual__cell"><strong>行為性</strong><span>人間の判断</span></div>
          <div class="research-visual__cell"><strong>依存</strong><span>社会的関係</span></div>
          <div class="research-visual__cell"><strong>ノート</strong><span>公開研究ログ</span></div>
          <div class="research-visual__cell"><strong>プロジェクト</strong><span>今後の創作</span></div>
          <div class="research-visual__cell"><strong>倫理</strong><span>制度とシステム</span></div>
          <div class="research-visual__cell"><strong>方法</strong><span>明晰な議論</span></div>
          <div class="research-visual__cell"><strong>近況</strong><span>現在の仕事</span></div>
        </div>
      </aside>
    </section>

    <section class="section" aria-labelledby="areas-title">
      <h2 id="areas-title">サイトの構成</h2>
      <div class="section-grid">
        <article class="panel">
          <h3>研究</h3>
          <p>信頼、依存、責任、AI倫理、社会認識論に関する学術研究。</p>
        </article>
        <article class="panel">
          <h3>公開ノート</h3>
          <p>確認済みのノート、エッセイ、プロジェクト、省察を長期的な知的資産として蓄積します。</p>
        </article>
        <article class="panel">
          <h3>近況</h3>
          <p>現在の研究、執筆、公開プロジェクトについての短い更新。</p>
        </article>
      </div>
    </section>

    <section class="section" aria-labelledby="latest-title">
      <h2 id="latest-title">最新の公開ノート</h2>
      <ContentList entries={latestEntries} locale="ja" />
    </section>
  </div>
</BaseLayout>
