---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"public">;
}

export async function getStaticPaths() {
  const entries = await getCollection("public");
  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, "") },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "long",
    day: "numeric"
  }).format(date);
---

<BaseLayout title={entry.data.title} description={entry.data.summary ?? entry.data.category}>
  <div class="page">
    <article class="prose">
      <p class="eyebrow">{entry.data.category} | {formatDate(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      {
        entry.data.summary && <p class="muted">{entry.data.summary}</p>
      }
      <ul class="tag-list" aria-label="Tags">
        {entry.data.tags.map((tag: string) => <li>{tag}</li>)}
      </ul>
      <Content />
    </article>
  </div>
</BaseLayout>
