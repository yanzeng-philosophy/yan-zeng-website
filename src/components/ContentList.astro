---
import type { CollectionEntry } from "astro:content";
import { noteHref, type Lang } from "../data/i18n";

interface Props {
  entries: CollectionEntry<"public">[];
  emptyText?: string;
  locale?: Lang;
}

const { entries, emptyText = "No public entries yet.", locale = "en" } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat(locale === "zh" ? "zh-CN" : locale === "ja" ? "ja-JP" : "en", {
    year: "numeric",
    month: "short",
    day: "numeric"
  }).format(date);
---

{
  entries.length > 0 ? (
    <ol class="content-list">
      {entries.map((entry) => (
        <li>
          <article class="content-row">
            <div>
              <p class="eyebrow">{entry.data.category} | {formatDate(entry.data.date)}</p>
              <h2><a href={noteHref(entry.id)}>{entry.data.title}</a></h2>
              {entry.data.summary && <p>{entry.data.summary}</p>}
            </div>
            <ul class="tag-list" aria-label="Tags">
              {entry.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <p class="muted">{emptyText}</p>
  )
}
