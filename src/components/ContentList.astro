---
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: CollectionEntry<"public">[];
  emptyText?: string;
}

const { entries, emptyText = "No public entries yet." } = Astro.props;
const base = import.meta.env.BASE_URL;
const basePath = base.endsWith("/") ? base : `${base}/`;
const hrefForEntry = (id: string) => `${basePath}notes/${id.replace(/\.md$/, "")}/`;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric"
  }).format(date);
---

{
  entries.length > 0 ? (
    <ol class="content-list">
      {entries.map((entry) => (
        <li>
          <article class="content-row">
            <div>
              <p class="eyebrow">{entry.data.category} | {formatDate(entry.data.date)}</p>
              <h2><a href={hrefForEntry(entry.id)}>{entry.data.title}</a></h2>
              {entry.data.summary && <p>{entry.data.summary}</p>}
            </div>
            <ul class="tag-list" aria-label="Tags">
              {entry.data.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <p class="muted">{emptyText}</p>
  )
}
