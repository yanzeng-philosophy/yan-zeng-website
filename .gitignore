node_modules/
dist/
.astro/
.DS_Store
.env
.env.*

# Private material must not be committed.
content/private/**
!content/private/README.md

# Drafts are not rendered. If the repo is public, real drafts should also stay uncommitted.
content/drafts/**/*.md
!content/drafts/README.md
!content/drafts/ai-generated/sample-draft.md

# Secret source files must stay local. Only encrypted payloads in public/secret may be published.
content/secret-source/**
!content/secret-source/README.md
